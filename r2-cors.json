{
  "rules": [
    {
      "allowed": {
        "origins": ["https://stayphora.fr", "https://www.stayphora.fr", "https://visite.stayphora.fr", "http://localhost:3000", "http://localhost:8787"],
        "methods": ["GET", "HEAD"],
        "headers": ["range"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
