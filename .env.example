# Copier en `.env` (ignoré par git). Variables lues AU BUILD par Next.js.

# Clé de site Turnstile. Valeur ci-dessous : clé de TEST Cloudflare (le widget passe toujours).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# URL publique du bucket R2 qui héberge les scènes 3D (sans / final).
# Laisser VIDE en local : les scènes sont alors lues dans /public/demo.
# Production : https://assets.stayphora.fr
NEXT_PUBLIC_ASSETS_URL=
